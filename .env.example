# Supabase 서버 함수용 환경변수 (값은 비워 둘 것. 실제 값은 Vercel 대시보드에 입력)
# 이 파일은 "이름표"만 공유하는 예시이며, 실제 .env 는 커밋하지 않는다.

# 프로젝트 API 주소 (비밀 아님)
SUPABASE_URL=

# 서버 전용 비밀키. 새 키(sb_secret_...) 권장, 레거시 service_role(JWT)도 동작.
# 이름은 SERVICE_ROLE 이지만 sb_secret_ 키를 넣어도 된다. 브라우저/저장소/채팅에 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=
# AI 질문하기(/api/ask)용 Gemini API 키. 서버 전용 비밀값. 값은 이 파일이 아니라 .env 와 Vercel 에만 넣는다.
GEMINI_API_KEY=

# (선택) 사용할 Gemini 모델. 비우면 api/ask.js 의 기본값을 쓴다. 모델이 종료되면 여기서 바꾼다.
GEMINI_MODEL=
